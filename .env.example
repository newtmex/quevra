# Copy to `.env` for local overrides. Shell values take precedence over this file.

# Optional: Monad keystore password for `pnpm validator:keys` / `pnpm validator:sign`.
# KEYSTORE_PASSWORD=

# Solonet local tester wallets. Funded with SOLONET_TESTER_FUND_AMOUNT_MON native MON
# by `pnpm solonet:fund-testers` and automatically during `pnpm solonet:deploy`.
SOLONET_TESTER_ADDRESSES=
SOLONET_TESTER_FUND_AMOUNT_MON=200000000

# Optional Solonet overrides for `pnpm solonet:deploy` / `pnpm solonet:fund-testers`.
# SOLONET_RPC=http://127.0.0.1:48080
# SOLONET_DEPLOYER_PRIVATE_KEY=
# SOLONET_PROTOCOL_OWNER_ADDRESS=
# SOLONET_GAUGE_REWARD_TOKEN_ADDRESS=
