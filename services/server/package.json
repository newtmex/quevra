{
  "name": "@quevra/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Quevra backend server",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "dev": "node src/dev.js",
    "build": "node --check src/index.js",
